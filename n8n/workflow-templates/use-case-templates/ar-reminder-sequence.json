{
  "name": "02 — AR Reminder Sequence",
  "nodes": [
    {
      "id": "va1b3c4d-0001-4000-8000-000000000001",
      "name": "Cron Daily 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "cronExpression": { "cronExpression": "0 9 * * *" }
        }
      }
    },
    {
      "id": "va1b3c4d-0001-4000-8000-000000000002",
      "name": "ERPNext — Overdue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Sales Invoice?filters={\"status\":\"Overdue\",\"outstanding_amount\":[\">\",0]}&fields=[\"name\",\"customer_name\",\"customer_phone\",\"outstanding_amount\",\"due_date\"]",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "va1b3c4d-0001-4000-8000-000000000003",
      "name": "Calculate Age",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const invoices = $input.all();\nconst now = new Date();\nreturn invoices.map(inv => {\n  const dueDate = new Date(inv.json.due_date);\n  const daysOverdue = Math.floor((now - dueDate) / (1000*60*60*24));\n  let tone = 'friendly';\n  if (daysOverdue > 30) tone = 'urgent';\n  else if (daysOverdue > 14) tone = 'firm';\n  return {\n    json: { ...inv.json, daysOverdue, tone }\n  };\n});"
      }
    },
    {
      "id": "va1b3c4d-0001-4000-8000-000000000004",
      "name": "Bifrost — Draft Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Draft payment reminder. Tone: {{tone}}. Friendly/firm/urgent as given. Language: {{language}}. Include invoice, amount, due date.\"},{\"role\":\"user\",\"content\":\"Invoice {{name}}, PKR {{outstanding_amount}}, due {{due_date}}, {{daysOverdue}} days overdue\"}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "va1b3c4d-0001-4000-8000-000000000005",
      "name": "WhatsApp — Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{customer_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"{{$node['Bifrost — Draft Reminder'].json.choices[0].message.content}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron Daily 9am": {
      "main": [[ { "node": "ERPNext — Overdue", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Overdue": {
      "main": [[ { "node": "Calculate Age", "type": "main", "index": 0 } ]]
    },
    "Calculate Age": {
      "main": [[ { "node": "Bifrost — Draft Reminder", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Draft Reminder": {
      "main": [[ { "node": "WhatsApp — Send", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["finance", "receivables"],
  "versionId": "1.0.0"
}
