{
  "name": "03 — Call Appointment Booking",
  "nodes": [
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000001",
      "name": "Dograh Booking Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "call-booking-{{client_id}}",
        "options": {}
      },
      "webhookId": "call-booking-{{client_id}}"
    },
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000002",
      "name": "Parse Booking",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "text", "value": "={{$json.text}}" },
            { "name": "caller_id", "value": "={{$json.caller_id}}" },
            { "name": "intent", "value": "" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000003",
      "name": "Bifrost — Extract Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Extract JSON booking: {\\\"service\\\":\\\"\\\",\\\"date\\\":\\\"\\\",\\\"time\\\":\\\"\\\",\\\"name\\\":\\\"\\\"}\"},{\"role\":\"user\",\"content\":$json.text}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000004",
      "name": "ERPNext — Check Slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Appointment?filters={\"appointment_date\":\"{{date}}\"}&fields=[\"appointment_time\",\"status\"]",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000005",
      "name": "ERPNext — Create Appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "{{erp_url}}/api/resource/Appointment",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "data", "value": "={\"customer_name\":\"{{name}}\",\"customer_phone\":\"{{caller_id}}\",\"appointment_date\":\"{{date}}\",\"appointment_time\":\"{{time}}\",\"service\":\"{{service}}\",\"status\":\"Scheduled\"}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "j1a2b3c4-0001-4000-8000-000000000006",
      "name": "Return Confirmation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"response\":\"Your {{service}} appointment is confirmed for {{date}} at {{time}}.\",\"caller_id\":\"{{caller_id}}\",\"appointment_id\":\"{{$node['ERPNext — Create Appointment'].json.data.name}}\"}"
      }
    }
  ],
  "connections": {
    "Dograh Booking Request": {
      "main": [[ { "node": "Parse Booking", "type": "main", "index": 0 } ]]
    },
    "Parse Booking": {
      "main": [[ { "node": "Bifrost — Extract Details", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Extract Details": {
      "main": [[ { "node": "ERPNext — Check Slots", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Check Slots": {
      "main": [[ { "node": "ERPNext — Create Appointment", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Create Appointment": {
      "main": [[ { "node": "Return Confirmation", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["callcentre", "booking"],
  "versionId": "1.0.0"
}
