{
  "name": "07 — Call Daily Report",
  "nodes": [
    {
      "id": "n1a2b3c4-0001-4000-8000-000000000001",
      "name": "Cron 7pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "cronExpression": { "cronExpression": "0 19 * * *" }
        }
      }
    },
    {
      "id": "n1a2b3c4-0001-4000-8000-000000000002",
      "name": "Langfuse — Today's Calls",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "http://10.60.0.10:3000/api/public/observations?projectId={{client_id}}&name=inbound-call&fromDate={{today}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{langfuse_secret_key}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n1a2b3c4-0001-4000-8000-000000000003",
      "name": "ERPNext — Today's Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Issue?filters={\"creation\":[\"between\",[\"{{today}}T00:00:00\",\"{{today}}T23:59:59\"]]}&fields=[\"name\",\"status\",\"priority\"]",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n1a2b3c4-0001-4000-8000-000000000004",
      "name": "Bifrost — Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Summarize today's call centre performance. Key: calls received, issues created, urgent items. Language: {{language}}. Max 300 chars.\"},{\"role\":\"user\",\"content\":$json}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n1a2b3c4-0001-4000-8000-000000000005",
      "name": "WhatsApp — Owner Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"📞 Call Centre Daily Report\\n{{$node['Bifrost — Summarize'].json.choices[0].message.content}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron 7pm": {
      "main": [[ { "node": "Langfuse — Today's Calls", "type": "main", "index": 0 } ]]
    },
    "Langfuse — Today's Calls": {
      "main": [[ { "node": "ERPNext — Today's Issues", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Today's Issues": {
      "main": [[ { "node": "Bifrost — Summarize", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Summarize": {
      "main": [[ { "node": "WhatsApp — Owner Report", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["callcentre", "reporting"],
  "versionId": "1.0.0"
}
