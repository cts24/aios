{
  "name": "05 — CX Review Collector",
  "nodes": [
    {
      "id": "s1a2b3c4-0001-4000-8000-000000000001",
      "name": "ERPNext Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "cx-review-{{client_id}}",
        "options": {}
      },
      "webhookId": "cx-review-{{client_id}}"
    },
    {
      "id": "s1a2b3c4-0001-4000-8000-000000000002",
      "name": "Parse Service",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "customer_phone", "value": "={{$json.customer_phone}}" },
            { "name": "customer_name", "value": "={{$json.customer_name}}" },
            { "name": "service", "value": "={{$json.service}}" },
            { "name": "completion_date", "value": "={{$json.completion_date}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "s1a2b3c4-0001-4000-8000-000000000003",
      "name": "Wait 24 Hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "resume": "afterTimeInterval",
        "waitTime": 86400
      }
    },
    {
      "id": "s1a2b3c4-0001-4000-8000-000000000004",
      "name": "WhatsApp — Review Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{customer_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"Hi {{customer_name}}, how was your {{service}} experience? Rate 1-5. Your feedback helps us improve!\"}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "s1a2b3c4-0001-4000-8000-000000000005",
      "name": "Mem0 — Log Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.30.0.35:8000/memory/{{customer_phone}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{mem0_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messages", "value": "=Review requested for {{service}} on {{completion_date}}" },
            { "name": "user_id", "value": "={{customer_phone}}" },
            { "name": "metadata", "value": "={\"type\":\"review_request\",\"service\":\"{{service}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "ERPNext Webhook": {
      "main": [[ { "node": "Parse Service", "type": "main", "index": 0 } ]]
    },
    "Parse Service": {
      "main": [[ { "node": "Wait 24 Hours", "type": "main", "index": 0 } ]]
    },
    "Wait 24 Hours": {
      "main": [[ { "node": "WhatsApp — Review Request", "type": "main", "index": 0 } ]]
    },
    "WhatsApp — Review Request": {
      "main": [[ { "node": "Mem0 — Log Review", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["cx", "reviews"],
  "versionId": "1.0.0"
}
