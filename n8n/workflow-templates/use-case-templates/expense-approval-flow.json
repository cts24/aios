{
  "name": "03 — Expense Approval Flow",
  "nodes": [
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000001",
      "name": "WhatsApp Expense Photo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "expense-{{client_id}}",
        "options": {}
      },
      "webhookId": "expense-{{client_id}}"
    },
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000002",
      "name": "Parse Expense",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "image_url", "value": "={{$json.body.media_url}}" },
            { "name": "employee_phone", "value": "={{$json.body.from}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000003",
      "name": "Bifrost — GPT-4o Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gpt-4o" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Extract receipt: vendor, amount, date, category, total. Return JSON.\"},{\"role\":\"user\",\"content\":[{\"type\":\"image_url\",\"image_url\":{\"url\":$json.image_url}}]}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000004",
      "name": "Mem0 — Get Employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "http://10.30.0.35:8000/memory/{{employee_phone}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{mem0_key}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000005",
      "name": "WhatsApp — Route to Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"💰 Expense Approval\\nEmployee: {{employee_phone}}\\nVendor: {{vendor}}\\nAmount: PKR {{amount}}\\nCategory: {{category}}\\nDate: {{date}}\\n\\nReply APPROVE or REJECT\"}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wa1b3c4d-0001-4000-8000-000000000006",
      "name": "Store Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "POST",
        "url": "{{supabase_url}}/rest/v1/pending_expenses",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "{{supabase_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "employee_phone", "value": "={{employee_phone}}" },
            { "name": "vendor", "value": "={{vendor}}" },
            { "name": "amount", "value": "={{amount}}" },
            { "name": "category", "value": "={{category}}" },
            { "name": "date", "value": "={{date}}" },
            { "name": "image_url", "value": "={{image_url}}" },
            { "name": "status", "value": "pending_approval" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "WhatsApp Expense Photo": {
      "main": [[ { "node": "Parse Expense", "type": "main", "index": 0 } ]]
    },
    "Parse Expense": {
      "main": [[ { "node": "Bifrost — GPT-4o Extract", "type": "main", "index": 0 } ]]
    },
    "Bifrost — GPT-4o Extract": {
      "main": [[ { "node": "Mem0 — Get Employee", "type": "main", "index": 0 } ]]
    },
    "Mem0 — Get Employee": {
      "main": [[ { "node": "WhatsApp — Route to Manager", "type": "main", "index": 0 } ]]
    },
    "WhatsApp — Route to Manager": {
      "main": [[ { "node": "Store Pending", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["finance", "expenses"],
  "versionId": "1.0.0"
}
