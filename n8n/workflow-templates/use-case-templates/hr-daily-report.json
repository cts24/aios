{
  "name": "07 — HR Daily Report",
  "nodes": [
    {
      "id": "g1a2b3c4-0001-4000-8000-000000000001",
      "name": "Cron 6pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "cronExpression": { "cronExpression": "0 18 * * *" }
        }
      }
    },
    {
      "id": "g1a2b3c4-0001-4000-8000-000000000002",
      "name": "ERPNext — Today's Attendance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Attendance?filters={\"attendance_date\":\"{{today}}\"}&fields=[\"employee_name\",\"status\",\"attendance_date\"]",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "g1a2b3c4-0001-4000-8000-000000000003",
      "name": "Calculate Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const records = $input.all();\nconst total = records.length;\nconst present = records.filter(r => r.json.status === 'Present').length;\nconst absent = records.filter(r => r.json.status === 'Absent').length;\nconst late = records.filter(r => r.json.status === 'Late').length;\nconst onLeave = records.filter(r => r.json.status === 'On Leave').length;\n\nreturn [{\n  json: {\n    total,\n    present,\n    absent,\n    late,\n    onLeave,\n    attendanceRate: total > 0 ? Math.round((present / total) * 100) : 0\n  }\n}];"
      }
    },
    {
      "id": "g1a2b3c4-0001-4000-8000-000000000004",
      "name": "Bifrost — Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Summarize daily HR report in Urdu/English. Keep under 200 chars.\"},{\"role\":\"user\",\"content\":$json}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "g1a2b3c4-0001-4000-8000-000000000005",
      "name": "WhatsApp — Manager Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"{{$node['Bifrost — Summarize'].json.choices[0].message.content}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron 6pm": {
      "main": [[ { "node": "ERPNext — Today's Attendance", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Today's Attendance": {
      "main": [[ { "node": "Calculate Stats", "type": "main", "index": 0 } ]]
    },
    "Calculate Stats": {
      "main": [[ { "node": "Bifrost — Summarize", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Summarize": {
      "main": [[ { "node": "WhatsApp — Manager Report", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["hrms", "reporting"],
  "versionId": "1.0.0"
}
