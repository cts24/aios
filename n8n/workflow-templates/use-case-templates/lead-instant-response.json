{
  "name": "04 — Lead Instant Response",
  "nodes": [
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000001",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "lead-respond-{{client_id}}",
        "options": {}
      },
      "webhookId": "lead-respond-{{client_id}}"
    },
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000002",
      "name": "Parse",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "phone", "value": "={{$json.phone}}" },
            { "name": "name", "value": "={{$json.name}}" },
            { "name": "score", "value": "={{$json.score}}" },
            { "name": "urgency", "value": "={{$json.urgency}}" },
            { "name": "lead_id", "value": "={{$json.lead_id}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000003",
      "name": "WhatsApp — Instant Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"Hi {{name}}! Thanks for reaching out. How can we help you today?\"}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000004",
      "name": "Check Hot Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{urgency}}", "operation": "equal", "value2": "high" }
          ]
        }
      }
    },
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000005",
      "name": "Dograh — Outbound Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200],
      "parameters": {
        "method": "POST",
        "url": "{{dograh_url}}/api/outbound/call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{dograh_api_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{phone}}" },
            { "name": "agent_id", "value": "=sales-{{client_id}}" },
            { "name": "webhook_url", "value": "={{webhook_base}}/outbound-result-{{client_id}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "dd1a2b3c-0001-4000-8000-000000000006",
      "name": "WhatsApp — Sales Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"🔥 Hot lead alert!\\n{{name}} ({{phone}})\\nScore: {{score}}/10\\nCalling now via Dograh.\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "New Lead Webhook": {
      "main": [[ { "node": "Parse", "type": "main", "index": 0 } ]]
    },
    "Parse": {
      "main": [[ { "node": "WhatsApp — Instant Reply", "type": "main", "index": 0 } ]]
    },
    "WhatsApp — Instant Reply": {
      "main": [[ { "node": "Check Hot Lead", "type": "main", "index": 0 } ]]
    },
    "Check Hot Lead": {
      "main": [
        [ { "node": "Dograh — Outbound Call", "type": "main", "index": 0 } ],
        [ { "node": "WhatsApp — Sales Alert", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["marketing", "leads"],
  "versionId": "1.0.0"
}
