{
  "name": "03 — Leave Request Handler",
  "nodes": [
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000001",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "path": "leave-{{client_id}}",
        "options": {}
      },
      "webhookId": "leave-{{client_id}}"
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000002",
      "name": "Extract Leave Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "employee_phone", "value": "={{$json.body.from}}" },
            { "name": "message", "value": "={{$json.body.text}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000003",
      "name": "Bifrost — Parse Leave",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Extract JSON: {\\\"date\\\":\\\"\\\",\\\"reason\\\":\\\"\\\",\\\"type\\\":\\\"sick/casual/annual\\\"}\"},{\"role\":\"user\",\"content\":$json.body.text}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000004",
      "name": "ERPNext — Check Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Leave Allocation?filters={\"employee\":\"{{employee}}\",\"leave_type\":\"{{type}}\"}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000005",
      "name": "Check Balance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{$json.data[0].total_leaves_allocated - $json.data[0].leaves_consumed}}", "operation": "largerEqual", "value2": 1 }
          ]
        }
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000006",
      "name": "WhatsApp — Route to Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"🏖️ Leave Request\\nEmployee: {{employee_name}}\\nDate: {{date}}\\nReason: {{reason}}\\nType: {{type}}\\n\\nReply YES or NO\"}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-8000-000000000007",
      "name": "WhatsApp — Insufficient Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 400],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{employee_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"❌ Insufficient {{type}} leave balance.\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "WhatsApp Webhook": {
      "main": [[ { "node": "Extract Leave Details", "type": "main", "index": 0 } ]]
    },
    "Extract Leave Details": {
      "main": [[ { "node": "Bifrost — Parse Leave", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Parse Leave": {
      "main": [[ { "node": "ERPNext — Check Balance", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Check Balance": {
      "main": [[ { "node": "Check Balance", "type": "main", "index": 0 } ]]
    },
    "Check Balance": {
      "main": [
        [ { "node": "WhatsApp — Route to Manager", "type": "main", "index": 0 } ],
        [ { "node": "WhatsApp — Insufficient Balance", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["hrms", "leave"],
  "versionId": "1.0.0"
}
