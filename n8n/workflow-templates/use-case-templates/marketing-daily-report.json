{
  "name": "08 — Marketing Daily Report",
  "nodes": [
    {
      "id": "hh1a2b3c-0001-4000-8000-000000000001",
      "name": "Cron 7pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "cronExpression": { "cronExpression": "0 19 * * *" }
        }
      }
    },
    {
      "id": "hh1a2b3c-0001-4000-8000-000000000002",
      "name": "Twenty CRM — Today Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "{{crm_url}}/rest/v1/leads?created_at=gte.{{today}}T00:00:00&select=count,source",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{crm_api_key}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "hh1a2b3c-0001-4000-8000-000000000003",
      "name": "Meta API — Post Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/{{facebook_page_id}}/insights?metric=page_impressions,page_engaged_users,page_fans&period=day",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{meta_access_token}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "hh1a2b3c-0001-4000-8000-000000000004",
      "name": "Bifrost — Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "http://10.20.0.10:4000/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{bifrost_key}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "mistral-7b" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Summarize today's marketing metrics. Focus on leads, engagement, key changes. Language: {{language}}. Max 250 chars.\"},{\"role\":\"user\",\"content\":$json}]" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "hh1a2b3c-0001-4000-8000-000000000005",
      "name": "WhatsApp — Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"📈 Marketing Daily\\n{{$node['Bifrost — Summarize'].json.choices[0].message.content}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron 7pm": {
      "main": [[ { "node": "Twenty CRM — Today Leads", "type": "main", "index": 0 } ]]
    },
    "Twenty CRM — Today Leads": {
      "main": [[ { "node": "Meta API — Post Stats", "type": "main", "index": 0 } ]]
    },
    "Meta API — Post Stats": {
      "main": [[ { "node": "Bifrost — Summarize", "type": "main", "index": 0 } ]]
    },
    "Bifrost — Summarize": {
      "main": [[ { "node": "WhatsApp — Owner", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["marketing", "reporting"],
  "versionId": "1.0.0"
}
