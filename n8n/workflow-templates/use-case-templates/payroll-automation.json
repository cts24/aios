{
  "name": "05 — Payroll Automation",
  "nodes": [
    {
      "id": "f1a2b3c4-0001-4000-8000-000000000001",
      "name": "Cron Monthly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "cronExpression": { "cronExpression": "0 9 28 * *" }
        }
      }
    },
    {
      "id": "f1a2b3c4-0001-4000-8000-000000000002",
      "name": "ERPNext — Get Attendance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Attendance?filters={\"attendance_date\":[\"between\",[\"{{month_start}}\",\"{{month_end}}\"]]}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1a2b3c4-0001-4000-8000-000000000003",
      "name": "ERPNext — Process Payroll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "{{erp_url}}/api/method/erpnext.payroll.doctype.payroll_entry.payroll_entry.make_payroll_entry",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "company", "value": "={{company_name}}" },
            { "name": "start_date", "value": "={{month_start}}" },
            { "name": "end_date", "value": "={{month_end}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1a2b3c4-0001-4000-8000-000000000004",
      "name": "ERPNext — Get Payslips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "{{erp_url}}/api/resource/Salary Slip?filters={\"docstatus\":1,\"start_date\":\"{{month_start}}\"}&fields=[\"employee_name\",\"employee\",\"gross_pay\",\"net_pay\",\"total_deduction\"]",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Token {{erp_api_key}}:{{erp_api_secret}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1a2b3c4-0001-4000-8000-000000000005",
      "name": "WhatsApp — Payroll Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{whatsapp_phone_id}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{whatsapp_token}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{manager_phone}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={\"body\":\"💰 Payroll Summary — {{month_name}}\\nTotal payslips: {{$node['ERPNext — Get Payslips'].json.data.length}}\\nTotal payroll: PKR {{$node['ERPNext — Get Payslips'].json.data | sum('net_pay')}}\"}" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron Monthly": {
      "main": [[ { "node": "ERPNext — Get Attendance", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Get Attendance": {
      "main": [[ { "node": "ERPNext — Process Payroll", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Process Payroll": {
      "main": [[ { "node": "ERPNext — Get Payslips", "type": "main", "index": 0 } ]]
    },
    "ERPNext — Get Payslips": {
      "main": [[ { "node": "WhatsApp — Payroll Summary", "type": "main", "index": 0 } ]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": ["hrms", "payroll"],
  "versionId": "1.0.0"
}
